katago-veri/

# KataGo weights and binaries do NOT go into the repository (354 MB). They live
# as release assets and CI pulls them from there. Not Git LFS: every clone
# would download 354 MB.
katago/
*.bin.gz
ffmpeg.exe

# Calibration output -- generated data, not source
*.log
